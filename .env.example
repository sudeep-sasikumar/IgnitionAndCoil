# Copy to .env and fill in. Never share or commit .env.
# Telegram (see README "Telegram alerts"): token from @BotFather, chat id from tools\get_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed when the dashboard is reachable beyond this PC (VPS). Use a long random password.
DASHBOARD_PASSWORD=
# Optional, free: a CoinGecko Demo API key (coingecko.com/en/api) loads the Highs tab's history faster.
COINGECKO_DEMO_API_KEY=
# VPS only: the DNS name pointing at the server (entered in Hostinger Docker Manager, README section 10)
DOMAIN=
